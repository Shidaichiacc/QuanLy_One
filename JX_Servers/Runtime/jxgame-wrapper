#!/usr/bin/env python3
"""Khởi chạy jx_linux_y với MOD trong phiên bản hoặc kho MOD dùng chung."""
import json
import os
import re
import sys
from pathlib import Path


ROOT = Path("/opt/QuanLy_One")
JX_ROOT = ROOT / "JX_Servers"
VERSIONS_ROOT = JX_ROOT / "JX_Versions"
ACTIVE_ROOT = JX_ROOT / "Active"
SERVER_ROOT = Path(os.environ.get("JX_SERVER_ROOT", str(ACTIVE_ROOT / "server1")))
SHARED_MOD_ROOT = Path(os.environ.get("JX_SHARED_MOD_ROOT", str(JX_ROOT / "MOD")))
STATE_ROOT = ROOT / "data" / "state" / "mods"
SAFE_LIBRARY = re.compile(r"(?:[A-Za-z0-9_.-]+/)?[A-Za-z0-9_.-]+\.so\Z")
MAX_LIBRARIES = 32


def active_version_name():
    try:
        relative = ACTIVE_ROOT.resolve(strict=True).relative_to(VERSIONS_ROOT.resolve(strict=True))
        return relative.parts[0]
    except (OSError, ValueError, IndexError):
        return "no-active-server"


def available_libraries(root, recursive=False):
    result = []
    try:
        root = root.resolve(strict=True)
    except OSError:
        return result
    candidates = list(root.glob("*.so"))
    if recursive:
        candidates.extend(root.glob("*/*.so"))
    for path in sorted(candidates, key=lambda item: str(item).lower()):
        try:
            relative = path.relative_to(root).as_posix()
            path.resolve(strict=True).relative_to(root)
            if not SAFE_LIBRARY.fullmatch(relative) or path.is_symlink() or not path.is_file():
                continue
            with path.open("rb") as library_file:
                if library_file.read(5) == b"\x7fELF\x01":
                    result.append(relative)
        except (OSError, ValueError):
            continue
    return result


def companion_for(selected, libraries):
    parent = os.path.dirname(selected)
    local = (parent + "/" if parent else "") + "special_drop_hook.so"
    if local in libraries:
        return local
    return "special_drop_hook.so" if "special_drop_hook.so" in libraries else ""


state_path = Path(os.environ.get("JX_MOD_STATE_PATH", str(STATE_ROOT / (active_version_name() + ".json"))))
legacy_state_path = ROOT / "data" / "state" / "game-mod.json"
state = {}
for candidate_path in (state_path, legacy_state_path):
    try:
        candidate = json.loads(candidate_path.read_text(encoding="utf-8"))
        if isinstance(candidate, dict):
            state = candidate
            break
    except (OSError, ValueError):
        continue

roots = {"version": SERVER_ROOT, "shared": SHARED_MOD_ROOT}
available = {
    "version": available_libraries(SERVER_ROOT),
    "shared": available_libraries(SHARED_MOD_ROOT, recursive=True),
}


def configuration_error(message):
    print("[MOD] Cau hinh LD_PRELOAD khong hop le: " + message, file=sys.stderr, flush=True)
    raise SystemExit(78)


def configured_entries():
    """Đọc schema danh sách mới; vẫn hiểu cấu hình một MOD của các bản cũ."""
    raw_entries = state.get("libraries")
    if isinstance(raw_entries, list):
        if len(raw_entries) > MAX_LIBRARIES:
            configuration_error(f"toi da {MAX_LIBRARIES} file .so")
        result = []
        seen = set()
        for item in raw_entries:
            if not isinstance(item, dict):
                configuration_error("danh sach co muc khong hop le")
            source = item.get("source", "")
            name = item.get("name", "")
            key = (source, name)
            if source not in roots or name not in available[source]:
                configuration_error(f"khong tim thay {source}:{name}")
            if key in seen:
                configuration_error(f"file bi trung {source}:{name}")
            seen.add(key)
            result.append({"source": source, "name": name})
        return result

    # Tương thích cấu hình cũ: core_library + special_drop_hook.so.
    source = state.get("source", "version")
    if source not in roots:
        source = "version"
    libraries = available[source]
    cores = [name for name in libraries if os.path.basename(name) != "special_drop_hook.so"]
    selected = state.get("core_library", "")
    if selected not in cores:
        selected = "vdk.so" if "vdk.so" in cores else (cores[0] if len(cores) == 1 else "")
    result = [{"source": source, "name": selected}] if selected else []
    companion = companion_for(selected, libraries) if selected else ""
    if bool(state.get("hook_enabled", bool(companion))) and companion:
        result.append({"source": source, "name": companion})
    return result


entries = configured_entries()
enabled = bool(state.get("enabled", bool(entries)))
if enabled and not entries:
    configuration_error("da bat MOD nhung danh sach rong")
preload = [str(roots[item["source"]] / item["name"]) for item in entries] if enabled else []
if preload:
    inherited = os.environ.get("LD_PRELOAD", "")
    os.environ["LD_PRELOAD"] = ":".join(preload + ([inherited] if inherited else []))
else:
    os.environ.pop("LD_PRELOAD", None)

binary = SERVER_ROOT / "jx_linux_y"
os.chdir(SERVER_ROOT)
os.execv(binary, [str(binary)])
