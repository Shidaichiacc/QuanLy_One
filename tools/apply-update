#!/usr/bin/env python3
"""Tải, xác minh và cài một GitHub Release JXNative từ tiến trình systemd riêng."""
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path, PurePosixPath


PROJECT_ROOT = Path("/opt/QuanLy_One")
STATE_ROOT = PROJECT_ROOT / "data" / "state"
STATUS_FILE = STATE_ROOT / "system-update.json"
LOG_FILE = STATE_ROOT / "system-update.log"
LOCK_FILE = Path("/run/jxnative-update.lock")
VERSION_RE = re.compile(r"\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?\Z")
REPOSITORY_RE = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\Z")


def write_status(state, percent, phase, message=""):
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    previous = {}
    try:
        previous = json.loads(STATUS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        pass
    logs = previous.get("logs", []) if isinstance(previous.get("logs"), list) else []
    if int(percent) <= 2 and phase == "Đang chuẩn bị":
        logs = []
    entry = {
        "time": time.strftime("%H:%M:%S"),
        "percent": max(0, min(100, int(percent))),
        "phase": str(phase)[:120],
        "message": str(message)[:1000],
        "state": state,
    }
    last = logs[-1] if logs and isinstance(logs[-1], dict) else {}
    if any(last.get(key) != entry[key] for key in ("percent", "phase", "state", "message")):
        logs.append(entry)
    payload = {**entry, "logs": logs[-60:], "updated": int(time.time())}
    temporary = STATUS_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, STATUS_FILE)


def log_line(message):
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as log_file:
        log_file.write(f"[{time.strftime('%F %T')}] {message}\n")


def fail(message):
    log_line("LỖI: " + message)
    write_status("error", 100, "Cập nhật thất bại", message)
    subprocess.run(["systemctl", "restart", "jx-webpanel", "quanly-public"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    raise SystemExit(1)


def validate_release(version, repository, archive_url, checksum_url):
    if not VERSION_RE.fullmatch(version):
        raise ValueError("Số phiên bản không hợp lệ")
    if not REPOSITORY_RE.fullmatch(repository):
        raise ValueError("Repository cập nhật không hợp lệ")
    archive_name = f"JXNative-v{version}.tar.gz"
    expected_prefix = f"https://github.com/{repository}/releases/download/v{version}/"
    if archive_url != expected_prefix + archive_name:
        raise ValueError("Đường dẫn gói cập nhật không đúng Release chính thức")
    if checksum_url != expected_prefix + archive_name + ".sha256":
        raise ValueError("Đường dẫn SHA256 không đúng Release chính thức")
    return archive_name


def download(url, destination, start_percent, end_percent, phase):
    request = urllib.request.Request(url, headers={"User-Agent": "JXNative-Self-Updater/1"})
    with urllib.request.urlopen(request, timeout=45) as response, destination.open("wb") as output:
        total = int(response.headers.get("Content-Length") or 0)
        received = 0
        while True:
            block = response.read(1024 * 1024)
            if not block:
                break
            output.write(block)
            received += len(block)
            if total:
                percent = start_percent + int((end_percent - start_percent) * received / total)
                write_status("working", percent, phase,
                             f"Đã tải {received / 1024 / 1024:.1f}/{total / 1024 / 1024:.1f} MB")
    if destination.stat().st_size == 0:
        raise ValueError("GitHub trả về file rỗng")


def verify_checksum(archive, checksum):
    text = checksum.read_text(encoding="utf-8", errors="replace")
    entries = [re.fullmatch(r"([0-9a-fA-F]{64}) [ *](.+)", line.strip()) for line in text.splitlines()]
    matches = [entry for entry in entries if entry and entry.group(2) == archive.name]
    match = matches[0] if len(matches) == 1 else None
    if not match:
        raise ValueError("File SHA256 không chứa mã kiểm tra hợp lệ")
    digest = hashlib.sha256()
    with archive.open("rb") as archive_file:
        for block in iter(lambda: archive_file.read(1024 * 1024), b""):
            digest.update(block)
    if digest.hexdigest().lower() != match.group(1).lower():
        raise ValueError("SHA256 không khớp; gói tải về có thể bị lỗi")


PROTECTED_PATHS = (
    ".git", "data/state", "data/uploads", "data/backups-code",
    "data/database/mysql/data", "data/database/mssql/data", "data/database/backups",
    "JX_Servers/Active", "JX_Servers/JX_Versions", "app/web/admin/venv",
)
REQUIRED_FILES = {
    "VERSION", ".env.example", "install.sh", "update.sh", "tools/apply-update",
    "app/web/admin/app.py", "deploy/docker-compose.yml",
    "data/database/seed/account_tong.bak", "data/database/seed/server1.sql",
}
GAME_UNITS = ("jxgame", "jxs3relay", "jxbishop", "jxgoddess", "jxrelaypay", "jxpaysys")


def validate_archive(archive, version=None):
    with tarfile.open(archive, "r:gz") as bundle:
        members = bundle.getmembers()
        regular_files = set()
        seen = set()
        for member in members:
            path = PurePosixPath(member.name)
            if path.is_absolute() or ".." in path.parts or not path.parts or path.parts[0] != "QuanLy_One":
                raise ValueError("Gói cập nhật có đường dẫn không an toàn: " + member.name)
            relative = path.relative_to("QuanLy_One").as_posix()
            if relative in seen:
                raise ValueError("Gói cập nhật có đường dẫn trùng: " + member.name)
            seen.add(relative)
            if any(part == ".env" or (part.startswith(".env.") and part != ".env.example") for part in path.parts):
                raise ValueError("Gói cập nhật chứa cấu hình riêng: " + member.name)
            if any(relative == root or relative.startswith(root + "/") for root in PROTECTED_PATHS):
                if not member.isdir() and not (member.isfile() and path.name == ".gitkeep" and member.size == 0):
                    raise ValueError("Gói cập nhật chứa dữ liệu vận hành: " + member.name)
            if member.issym():
                if relative != "JX_Servers/Runtime/config" or member.linkname != "../Config":
                    raise ValueError("Gói cập nhật có symlink không được phép: " + member.name)
            elif not (member.isdir() or member.isfile()):
                raise ValueError("Gói cập nhật chứa loại file không được phép: " + member.name)
            if member.isfile():
                regular_files.add(relative)
        missing = REQUIRED_FILES - regular_files
        if missing:
            raise ValueError("Gói cập nhật thiếu file: " + ", ".join(sorted(missing)))
        version_file = bundle.extractfile("QuanLy_One/VERSION")
        packaged_version = version_file.read(128).decode("utf-8").strip()
        if not VERSION_RE.fullmatch(packaged_version) or (version and packaged_version != version):
            raise ValueError("VERSION trong gói không khớp phiên bản yêu cầu")


def require_stopped_game():
    # Kiểm tra lại sau khi tải; game có thể được bật trong thời gian chờ tải.
    for unit in GAME_UNITS:
        result = subprocess.run(
            ["systemctl", "show", unit, "--property=ActiveState", "--value"],
            capture_output=True, text=True, timeout=10, check=False)
        if result.returncode != 0 or result.stdout.strip() not in ("inactive", "failed"):
            raise RuntimeError("Hãy Stop All trước khi giải nén cập nhật: " + unit)


def backup_changed_shared_mods(archive):
    """Không để file MOD chính thức trong Release âm thầm đè bản người dùng."""
    prefix = "QuanLy_One/JX_Servers/MOD/"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    with tarfile.open(archive, "r:gz") as bundle:
        for member in bundle.getmembers():
            if not member.isfile() or not member.name.startswith(prefix):
                continue
            relative = member.name[len(prefix):]
            if not relative or "/" in relative:
                continue
            current = PROJECT_ROOT / "JX_Servers" / "MOD" / relative
            if not current.is_file() or current.is_symlink():
                continue
            packaged = bundle.extractfile(member)
            if packaged is None:
                continue
            packaged_hash = hashlib.sha256(packaged.read()).digest()
            current_hash = hashlib.sha256(current.read_bytes()).digest()
            if packaged_hash == current_hash:
                continue
            backup = current.with_name(current.name + ".user-" + stamp)
            shutil.copy2(current, backup)
            log_line(f"Đã giữ MOD tùy chỉnh: {current.name} -> {backup.name}")


def extract_archive(archive):
    with tarfile.open(archive, "r:gz") as bundle:
        bundle.extractall(PROJECT_ROOT.parent, filter="data")


def run_update_script():
    command = ["bash", str(PROJECT_ROOT / "update.sh")]
    with LOG_FILE.open("a", encoding="utf-8") as log_file:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   text=True, bufsize=1)
        assert process.stdout is not None
        for line in process.stdout:
            clean = line.rstrip()
            log_file.write(line)
            log_file.flush()
            if clean:
                write_status("working", 85, "Đang áp dụng bản cập nhật", clean)
        return process.wait()


def main():
    if os.geteuid() != 0:
        fail("Tiến trình cập nhật cần quyền root")
    if len(sys.argv) != 5:
        fail("Thiếu tham số cập nhật")
    version, repository, archive_url, checksum_url = sys.argv[1:]
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    lock = LOCK_FILE.open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        raise SystemExit("Đang có một tiến trình cập nhật khác")
    original_version = None
    extraction_started = False
    try:
        original_version = (PROJECT_ROOT / "VERSION").read_bytes()
        archive_name = validate_release(version, repository, archive_url, checksum_url)
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        LOG_FILE.write_text("", encoding="utf-8")
        write_status("working", 2, "Đang chuẩn bị", f"Chuẩn bị cập nhật lên v{version}")
        with tempfile.TemporaryDirectory(prefix="jxnative-update-", dir="/var/tmp") as temporary:
            work = Path(temporary)
            archive = work / archive_name
            checksum = work / (archive_name + ".sha256")
            download(checksum_url, checksum, 3, 8, "Đang tải SHA256")
            download(archive_url, archive, 10, 55, "Đang tải gói cập nhật")
            write_status("working", 60, "Đang kiểm tra SHA256", "Xác minh tính toàn vẹn của gói")
            verify_checksum(archive, checksum)
            write_status("working", 68, "Đang kiểm tra gói", "Kiểm tra đường dẫn và nội dung bản phát hành")
            validate_archive(archive, version)
            require_stopped_game()
            backup_changed_shared_mods(archive)
            write_status("working", 75, "Đang giải nén", "Cài file chương trình mới vào /opt/QuanLy_One")
            extraction_started = True
            extract_archive(archive)
            write_status("working", 82, "Đang chạy update.sh", "Web sẽ mất kết nối trong thời gian ngắn")
            if run_update_script() != 0:
                raise RuntimeError("update.sh kết thúc với lỗi; xem nhật ký cập nhật")
        installed = (PROJECT_ROOT / "VERSION").read_text(encoding="utf-8").strip()
        if installed != version:
            raise RuntimeError(f"VERSION sau cập nhật là {installed}, dự kiến {version}")
        log_line(f"Cập nhật v{version} hoàn tất")
        write_status("success", 100, "Cập nhật hoàn tất", f"JXNative đã lên v{version}")
    except (OSError, ValueError, RuntimeError, tarfile.TarError, urllib.error.URLError, subprocess.TimeoutExpired) as exc:
        if extraction_started:
            # Giữ khả năng thử lại; đây không phải rollback toàn bộ mã/cấu hình.
            (PROJECT_ROOT / "VERSION").write_bytes(original_version)
        fail(str(exc))
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
        except OSError:
            pass
        lock.close()


if __name__ == "__main__":
    main()
