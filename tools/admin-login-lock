#!/usr/bin/env python3
"""Inspect and clear JXNative Admin login locks from SSH."""

import os
import sys
from pathlib import Path


PROJECT_ROOT = Path(os.environ.get("QUANLY_ONE_ROOT", "/opt/QuanLy_One"))
sys.path.insert(0, str(PROJECT_ROOT / "app" / "shared"))

from admin_login_security import AdminLoginSecurity, format_duration, format_timestamp  # noqa: E402


def usage():
    print("Cách dùng:")
    print("  sudo /opt/QuanLy_One/tools/admin-login-lock list")
    print("  sudo /opt/QuanLy_One/tools/admin-login-lock unlock IP")
    print("  sudo /opt/QuanLy_One/tools/admin-login-lock unlock-all")


def main():
    if os.geteuid() != 0:
        print("Lỗi: hãy chạy lệnh bằng sudo/root.", file=sys.stderr)
        return 1
    command = sys.argv[1] if len(sys.argv) > 1 else "list"
    security = AdminLoginSecurity(PROJECT_ROOT / "data" / "state")
    if command == "list" and len(sys.argv) == 2:
        rows = security.snapshot(audit_limit=0)["entries"]
        if not rows:
            print("Không có IP nào đang được theo dõi.")
            return 0
        print(f"{'IP':<40} {'Cấp':<5} {'Sai':<5} {'Trạng thái':<24} Lần sai cuối")
        for row in rows:
            state = "KHÓA " + format_duration(row["remaining"]) if row["locked"] else "Cho phép"
            print(f"{row['ip']:<40} {row['level']:<5} {row['failures']:<5} {state:<24} {format_timestamp(row['last_failure'])}")
        return 0
    if command == "unlock" and len(sys.argv) == 3:
        existed = security.unlock(sys.argv[2], source="ssh")
        print(("Đã mở khóa và đặt lại: " if existed else "IP chưa có trong danh sách; đã ghi nhật ký: ") + sys.argv[2])
        return 0
    if command == "unlock-all" and len(sys.argv) == 2:
        count = security.unlock_all(source="ssh")
        print(f"Đã mở khóa/đặt lại {count} IP.")
        return 0
    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
